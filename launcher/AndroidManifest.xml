<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Live TV: talks to the Tvheadend server configured in the app, nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminders: re-armed after a restart, and allowed to pop up over other apps (granted over ADB). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Uninstall" in an app's hold-OK menu (Android still asks the user to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Control Center → Bluetooth opens Android TV's accessory pairing screen, which wants this (asked for on first use). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Channels from tuner apps on the box (Android TV inputs); a normal permission, no prompt. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- "Last opened" under dock apps that announce nothing while playing; usage access, granted over ADB. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <!-- Tvheadend serves plain HTTP on the LAN. -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/ic_home"
        android:banner="@drawable/ic_home"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Player"
            android:supportsPictureInPicture="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Player"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".RecordingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Player"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Player"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".Reminders$Popup"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".SleepTimer$Receiver"
            android:exported="false" />

        <receiver
            android:name=".Reminders$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hears what other apps play (media sessions) for "last watched" under dock apps.
             Enabled over ADB: cmd notification allow_listener io.github.ksfikas.tvhome/io.github.ksfikas.tvhome.MediaWatcher -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:label="@string/service_media_watcher"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Screensaver (photos, clock, weather, news ticker). Chosen over ADB:
             settings put secure screensaver_components io.github.ksfikas.tvhome/.Screensaver -->
        <service
            android:name=".Screensaver"
            android:exported="true"
            android:label="@string/service_screensaver"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Sleep timer: may turn the screen off (standby), nothing else. Activated over ADB. -->
        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
